{
    "name": "fman/web-help-system",
    "description": "User-facing help site for fman (keyboard shortcuts reference).",
    "type": "project",
    "require": {
        "php": "^8.5",
        "twig/twig": "^3.0",
        "monolog/monolog": "^3.0",
        "xida/php-localization": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "league/commonmark": "^2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BenjaminKobjolke/php-localization.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}

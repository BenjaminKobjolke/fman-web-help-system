{% extends 'base.html.twig' %}

{% block content %}
    <section class="hero">
        <h1>{{ t(TK.HOME_TITLE) }}</h1>
        <p class="tagline">{{ t(TK.APP_TAGLINE) }}</p>
        <p class="intro">{{ t(TK.HOME_INTRO) }}</p>

        {{ include('_search.html.twig', {hero: true}) }}

        {# ponytail: one app, one repo — the URLs live here rather than in config.
           Move them out only if a second download target ever appears. #}
        <p class="actions">
            <a class="button button-primary"
               href="https://github.com/BenjaminKobjolke/fman/releases">{{ t(TK.HOME_DOWNLOAD) }}</a>
            <a class="button button-ghost"
               href="https://github.com/BenjaminKobjolke/fman">{{ t(TK.HOME_SOURCE) }}</a>
        </p>
        <p class="note">{{ t(TK.HOME_DOWNLOAD_NOTE) }}</p>
    </section>

    <section class="topics">
        <h2>{{ t(TK.HOME_TOPICS) }}</h2>
        <div class="cards">
            <a class="card" href="{{ base }}keybindings">
                <h3>{{ t(TK.KB_HEADING) }}</h3>
                <p>{{ t(TK.HOME_KB_CARD_SUMMARY) }}</p>
            </a>
            {% for article in articles %}
                <a class="card" href="{{ base }}{{ article.slug }}">
                    <h3>{{ article.title }}</h3>
                    <p>{{ article.summary }}</p>
                </a>
            {% endfor %}
        </div>
    </section>
{% endblock %}
